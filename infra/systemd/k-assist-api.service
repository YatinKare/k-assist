[Unit]
Description=K-Assist Go API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStart="@REPO_ROOT@/bin/k-assist-api"
Environment=LISTEN_ADDR=127.0.0.1:8090
Environment=GOMEMLIMIT=80MiB
EnvironmentFile=-%h/.config/k-assist/api.env
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
CPUQuota=50%
MemoryHigh=96M
MemoryMax=128M
TasksMax=64
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
